# Required: Google AI Studio key (https://aistudio.google.com/apikey). Server-side only, never exposed to the browser.
GEMINI_API_KEY=

# Optional: comma-separated model fallback chains. Google retires model ids regularly.
# GEMINI_LITE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
# GEMINI_DEEP_MODELS=gemini-3.1-pro-preview,gemini-3.5-flash,gemini-3.8-flash
# GEMINI_FIRST_TOKEN_MS=22000
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: secret for signing the per-document search index (HMAC-SHA256).
# Defaults to a key derived from GEMINI_API_KEY, so it works with no extra setup.
# INDEX_SIGNING_SECRET=
